<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
<office:font-face-decls><style:font-face style:name="Liberation Sans" svg:font-family="'Liberation Sans'"/></office:font-face-decls>
<office:styles><style:default-style style:family="paragraph"><style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/><style:text-properties style:font-name="Liberation Sans" fo:font-size="12pt"/></style:default-style></office:styles>
<office:automatic-styles>
<style:page-layout style:name="A4"><style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="2cm" fo:margin-bottom="2cm" fo:margin-left="2cm" fo:margin-right="2cm"/></style:page-layout>
<style:style style:name="Title" style:family="paragraph"><style:paragraph-properties fo:margin-bottom="0.4cm"/><style:text-properties fo:font-size="16pt" style:text-underline-style="solid" style:text-underline-width="auto" style:text-underline-color="font-color"/></style:style>
<style:style style:name="Strong" style:family="paragraph"><style:paragraph-properties fo:margin-bottom="0.3cm"/><style:text-properties fo:font-size="14pt" fo:font-weight="bold"/></style:style>
<style:style style:name="Body" style:family="paragraph"><style:paragraph-properties fo:margin-top="0.3cm" fo:margin-bottom="0.4cm"/></style:style>
<style:style style:name="T" style:family="table"><style:table-properties style:width="17cm" table:align="left"/></style:style>
<style:style style:name="T.A" style:family="table-column"><style:table-column-properties style:column-width="4.5cm"/></style:style>
<style:style style:name="T.B" style:family="table-column"><style:table-column-properties style:column-width="12.5cm"/></style:style>
<style:style style:name="C" style:family="table-cell"><style:table-cell-properties fo:padding-left="0.19cm" fo:padding-right="0.19cm" fo:padding-top="0cm" fo:padding-bottom="0cm" fo:border="0.75pt solid #000000"/></style:style>
</office:automatic-styles>
<office:master-styles><style:master-page style:name="Standard" style:page-layout-name="A4"/></office:master-styles>
<office:body><office:text>
<text:p text:style-name="Title">Home Visit Assessment:</text:p>
<text:p text:style-name="Strong">Mr Sample Person</text:p>
<text:p text:style-name="Strong">12 Example Way, Testville Heights 3999</text:p>
<text:p text:style-name="Body">Thank you for referring Sam for physiotherapy treatment at home.</text:p>
<table:table table:name="Assessment" table:style-name="T">
<table:table-column table:style-name="T.A"/><table:table-column table:style-name="T.B"/>
<table:table-row><table:table-cell table:style-name="C"><text:p>Home assessment</text:p></table:table-cell><table:table-cell table:style-name="C"><text:p>Sam lives alone in a double storey house with level pathways to all rooms. There are 3 steps between the living area and the shower. There are no modifications to the home. There is a rail at the back door for access.</text:p></table:table-cell></table:table-row>
<table:table-row><table:table-cell table:style-name="C"><text:p>Steps</text:p></table:table-cell><table:table-cell table:style-name="C"><text:p>There are 2 steps at the front entrance and a staircase to the second level where the bedroom is. Sam climbs them twice a day, morning and night. We reviewed gait and use of the rail.</text:p></table:table-cell></table:table-row>
<table:table-row><table:table-cell table:style-name="C"><text:p>Mobility and transfers</text:p></table:table-cell><table:table-cell table:style-name="C"><text:p>Sam uses a single point stick to walk around the house and uses it out in the community.</text:p><text:p>Sam reports no falls in the past year.</text:p></table:table-cell></table:table-row>
</table:table>
<text:p text:style-name="Body">Please contact the clinic with any questions about this report.</text:p>
</office:text></office:body></office:document>

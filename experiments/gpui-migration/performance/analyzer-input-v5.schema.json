{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://butterpaper.invalid/schemas/bp-analyzer-input-v5.json",
  "title": "Butter Paper final paired analyzer input v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "decision_contract_version",
    "workload_artifact_sha256",
    "workload_byte_sha256",
    "schedule_seed",
    "candidate_manifest_sha256",
    "candidate_artifacts",
    "reference_crop_sha256_by_id",
    "artifact_tree",
    "run_manifest",
    "property_correctness",
    "view_state_pairs",
    "bundles",
    "hard_component_reports",
    "dynamic_fidelity_pairs"
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "implementation": { "enum": ["electron", "gpui"] },
    "pairPosition": { "enum": ["first", "second"] },
    "launchBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "launch_id",
        "schedule_index",
        "phase",
        "inference_eligible",
        "journey",
        "pair",
        "pair_position",
        "implementation",
        "component",
        "component_index",
        "input_lane",
        "candidate_manifest_sha256",
        "fixture_sha256_by_id",
        "raw_report_path",
        "started_at",
        "ended_at",
        "started_monotonic_ms",
        "ended_monotonic_ms"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "launch_id": { "type": "string", "minLength": 1 },
        "schedule_index": { "type": "integer", "minimum": 0, "maximum": 1261 },
        "phase": { "enum": ["correctness", "calibration", "final"] },
        "inference_eligible": { "type": "boolean" },
        "journey": { "type": "string", "minLength": 1 },
        "pair": { "type": "integer", "minimum": 0, "maximum": 24 },
        "pair_position": { "$ref": "#/$defs/pairPosition" },
        "implementation": { "$ref": "#/$defs/implementation" },
        "component": { "type": "string", "minLength": 1 },
        "component_index": { "type": "integer", "minimum": 0 },
        "input_lane": { "type": "string", "minLength": 1 },
        "candidate_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "fixture_sha256_by_id": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/sha256" }
        },
        "raw_report_path": { "type": "string", "minLength": 1 },
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at": { "type": "string", "format": "date-time" },
        "started_monotonic_ms": { "type": "number", "minimum": 0 },
        "ended_monotonic_ms": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "dynamicArtifactSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crop_id",
        "launch_id",
        "capture_id",
        "capture_started_monotonic_ms",
        "capture_ended_monotonic_ms",
        "screenshot",
        "candidate_crop",
        "registered_reference_crop",
        "source_reference_crop"
      ],
      "properties": {
        "crop_id": { "type": "string", "minLength": 1 },
        "launch_id": { "type": "string", "minLength": 1 },
        "capture_id": { "type": "string", "minLength": 1 },
        "capture_started_monotonic_ms": { "type": "number", "minimum": 0 },
        "capture_ended_monotonic_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "screenshot": { "$ref": "#/$defs/artifact" },
        "candidate_crop": { "$ref": "#/$defs/artifact" },
        "registered_reference_crop": { "$ref": "#/$defs/artifact" },
        "source_reference_crop": { "$ref": "#/$defs/artifact" }
      }
    }
  },
  "properties": {
    "schema_version": { "const": 1 },
    "protocol_version": { "const": "bp-perf-v5" },
    "decision_contract_version": { "const": "bp-perf-v5-decision-1" },
    "workload_artifact_sha256": { "$ref": "#/$defs/sha256" },
    "workload_byte_sha256": { "$ref": "#/$defs/sha256" },
    "schedule_seed": { "type": "integer" },
    "candidate_manifest_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": ["electron", "gpui"],
      "properties": {
        "electron": { "$ref": "#/$defs/sha256" },
        "gpui": { "$ref": "#/$defs/sha256" }
      }
    },
    "candidate_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["electron", "gpui"],
      "properties": {
        "electron": { "type": "object" },
        "gpui": { "type": "object" }
      }
    },
    "reference_crop_sha256_by_id": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 3,
      "additionalProperties": { "$ref": "#/$defs/sha256" }
    },
    "artifact_tree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_root", "reference_root", "references"],
      "properties": {
        "run_root": { "type": "string", "minLength": 1 },
        "reference_root": { "type": "string", "minLength": 1 },
        "references": {
          "type": "object",
          "minProperties": 3,
          "maxProperties": 3,
          "additionalProperties": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "run_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "checksum"],
      "properties": {
        "manifest": { "$ref": "#/$defs/artifact" },
        "checksum": { "$ref": "#/$defs/artifact" }
      }
    },
    "property_correctness": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "implementation",
          "component",
          "raw_report_path",
          "raw_report_sha256",
          "hard_report_path",
          "hard_report_sha256",
          "passed",
          "correctness_passed",
          "known_baseline_defect_id",
          "launch_binding_v5"
        ],
        "properties": {
          "implementation": { "$ref": "#/$defs/implementation" },
          "component": { "const": "native-property-edit-undo" },
          "raw_report_path": { "type": "string", "minLength": 1 },
          "raw_report_sha256": { "$ref": "#/$defs/sha256" },
          "hard_report_path": { "type": "string", "minLength": 1 },
          "hard_report_sha256": { "$ref": "#/$defs/sha256" },
          "passed": { "const": true },
          "correctness_passed": { "type": "boolean" },
          "known_baseline_defect_id": {
            "type": ["string", "null"]
          },
          "launch_binding_v5": { "$ref": "#/$defs/launchBinding" }
        }
      }
    },
    "view_state_pairs": {
      "type": "array",
      "minItems": 180,
      "maxItems": 180,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "phase",
          "journey",
          "pair",
          "passed",
          "failures",
          "component_matches",
          "evidence_sha256"
        ],
        "properties": {
          "schema_version": { "const": 1 },
          "phase": { "enum": ["calibration", "final"] },
          "journey": { "type": "string", "minLength": 1 },
          "pair": { "type": "integer", "minimum": 1, "maximum": 24 },
          "passed": { "const": true },
          "failures": { "type": "array", "maxItems": 0 },
          "component_matches": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["component", "applicable"],
              "properties": {
                "component": { "type": "string", "minLength": 1 },
                "applicable": { "type": "boolean" },
                "passed": { "type": "boolean" },
                "failures": { "type": "array" },
                "electron_evidence_sha256": {
                  "type": ["string", "null"],
                  "pattern": "^[0-9a-f]{64}$"
                },
                "gpui_evidence_sha256": {
                  "type": ["string", "null"],
                  "pattern": "^[0-9a-f]{64}$"
                },
                "evidence_sha256": { "$ref": "#/$defs/sha256" }
              }
            }
          },
          "evidence_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "bundles": {
      "type": "array",
      "minItems": 360,
      "maxItems": 360,
      "items": {
        "type": "object",
        "required": [
          "bundle_id",
          "phase",
          "inference_eligible",
          "journey",
          "pair",
          "pair_position",
          "implementation",
          "path",
          "sha256",
          "passed"
        ]
      }
    },
    "hard_component_reports": {
      "type": "array",
      "minItems": 144,
      "maxItems": 144,
      "items": {
        "type": "object",
        "required": [
          "phase",
          "inference_eligible",
          "journey",
          "pair",
          "pair_position",
          "implementation",
          "component",
          "component_index",
          "input_lane",
          "path",
          "sha256",
          "measurements",
          "quality_measurements",
          "benefit_metrics_eligible",
          "correctness_passed",
          "known_baseline_defect_id",
          "launch_binding_v5",
          "dynamic_crop_artifacts"
        ],
        "properties": {
          "phase": { "const": "final" },
          "inference_eligible": { "const": true },
          "implementation": { "$ref": "#/$defs/implementation" },
          "pair_position": { "$ref": "#/$defs/pairPosition" },
          "pair": { "type": "integer", "minimum": 1, "maximum": 24 },
          "input_lane": { "const": "native-x11-xtest" },
          "launch_binding_v5": { "$ref": "#/$defs/launchBinding" },
          "dynamic_crop_artifacts": {
            "type": "array",
            "maxItems": 3,
            "items": { "$ref": "#/$defs/dynamicArtifactSet" }
          }
        }
      }
    },
    "dynamic_fidelity_pairs": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://butterpaper.invalid/schemas/bp-comparison-workload-v5-materialized.json",
  "title": "Butter Paper comparison workload v5 materialized runtime artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "decision_contract_version",
    "supersedes",
    "seed",
    "coordinate_space",
    "environment",
    "source_manifest",
    "fixtures",
    "assets",
    "journeys",
    "stress_lanes",
    "supplementary_lanes",
    "expected",
    "canonical_hashes"
  ],
  "properties": {
    "schema_version": { "const": "bp-comparison-workload-v3" },
    "manifest_id": { "const": "bp-perf-v5-decision-1" },
    "decision_contract_version": { "const": "bp-perf-v5-decision-1" },
    "supersedes": { "const": "bp-perf-v4-decision-1" },
    "seed": { "type": "integer" },
    "coordinate_space": { "const": "pdf-points-bottom-left" },
    "environment": { "type": "object" },
    "source_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file", "artifact_sha256", "byte_sha256"],
      "properties": {
        "id": { "const": "bp-perf-v4-decision-1" },
        "file": { "const": "./comparison-workload-v4.materialized.json" },
        "artifact_sha256": {
          "const": "4a826bd3c19f3c7693128961f43064e5b7414e799a0f791b7f3381ed59e897b1"
        },
        "byte_sha256": {
          "const": "8828be7c4c7c05a19007bd315c4fc1844a93278c967d49614387c2ae6cfeff52"
        }
      }
    },
    "fixtures": { "type": "array", "minItems": 5, "maxItems": 5 },
    "assets": { "type": "array", "minItems": 1 },
    "journeys": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fixtures", "commands"],
        "properties": {
          "id": { "type": "string" },
          "fixtures": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "commands": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "operation", "expected_milestones"],
              "properties": {
                "id": { "type": "string" },
                "operation": { "type": "string" },
                "expected_milestones": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "stress_lanes": { "type": "array", "minItems": 1 },
    "supplementary_lanes": { "type": "array", "minItems": 1 },
    "expected": {
      "type": "object",
      "required": ["v5_hard_component_rules"],
      "properties": {
        "v5_hard_component_rules": {
          "type": "object",
          "required": ["gpui_multi_document_absolute_safety_budgets"],
          "properties": {
            "gpui_multi_document_absolute_safety_budgets": {
              "$ref": "#/$defs/gpuiMultiDocumentAbsoluteSafetyBudgets"
            }
          }
        }
      }
    },
    "canonical_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representative_command_stream_sha256",
        "representative_milestone_stream_sha256",
        "representative_fixture_command_mapping_sha256",
        "stress_command_stream_sha256",
        "expected_state_sha256"
      ],
      "properties": {
        "representative_command_stream_sha256": {
          "const": "99ea727689bf4bf725cae92a7d0d86383cf7e85aa0e8252228eed346866e10cd"
        },
        "representative_milestone_stream_sha256": {
          "const": "91b25071a024ae00c2a96ebb0b6c06849650a04abd2118770dcbfe894247d244"
        },
        "representative_fixture_command_mapping_sha256": {
          "const": "3b8622cd2cbec09f1e3740240e996764ca30e15f6a6fa5d664fccc592ff2dad4"
        },
        "stress_command_stream_sha256": {
          "const": "a7e63ced8f1379758d42c56f3a608100270f0131393f65ca7841bd9e3fb0f3e6"
        },
        "expected_state_sha256": {
          "const": "e2e0b1e812545355cbb76c0e653576f8cff21f2c37c7018dcc9cd86c36e38a8b"
        }
      }
    }
  },
  "$defs": {
    "gpuiMultiDocumentAbsoluteSafetyBudgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicability",
        "aggregation",
        "conjunction",
        "outcomes",
        "metrics"
      ],
      "properties": {
        "applicability": {
          "const": "every-live-gpui-multi-document-session-report; mandatory-when-electron-benefit-metrics-ineligible"
        },
        "aggregation": {
          "const": "maximum-across-retained-final-gpui-multi-document-reports"
        },
        "conjunction": { "const": "all-seven" },
        "outcomes": {
          "const": {
            "exceeded_finite_valid": "measured-no",
            "missing_nonfinite_or_structurally_invalid": "blocked-not-decision-ready"
          }
        },
        "metrics": {
          "const": {
            "cpu_seconds": {
              "maximum": 120,
              "unit": "process-cpu-seconds",
              "provenance": "new-v5-safety-cap-no-v4-absolute"
            },
            "cgroup_peak_memory_bytes": {
              "maximum": 1610612736,
              "unit": "bytes",
              "provenance": "summarize-paired-v4 process_memory absoluteBudgetFor"
            },
            "product_wall_or_latency_ms": {
              "maximum": 60000,
              "unit": "milliseconds",
              "allowed_source": ["product-latency", "component-wall"],
              "provenance": "new-v5-safety-cap-no-v4-multi-document-map"
            },
            "application_frame_interval_p95_ms": {
              "maximum": 25,
              "unit": "milliseconds",
              "provenance": "v4 native frame absoluteBudgetFor"
            },
            "native_input_to_application_frame_ack_p95_ms": {
              "maximum": 33.333333333333336,
              "unit": "milliseconds",
              "provenance": "v4 1000/30 native ack absoluteBudgetFor"
            },
            "baseline_adjusted_gpu_peak_memory_mib": {
              "maximum": 2048,
              "unit": "MiB",
              "provenance": "v4 GPU memory absoluteBudgetFor"
            },
            "baseline_adjusted_gpu_utilization_p95_percent": {
              "maximum": 100,
              "unit": "percent",
              "provenance": "new-v5 physical percentage ceiling"
            }
          }
        }
      }
    }
  }
}

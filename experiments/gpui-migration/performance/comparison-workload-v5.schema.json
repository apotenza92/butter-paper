{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://butterpaper.invalid/schemas/bp-comparison-workload-v3.json",
  "title": "Butter Paper comparison workload v5 immutable overlay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "manifest_id",
    "decision_contract_version",
    "supersedes",
    "seed",
    "source_manifest",
    "journey_extensions",
    "additional_journeys",
    "additional_commands",
    "expected_extensions",
    "canonical_hashes"
  ],
  "properties": {
    "$schema": { "const": "./comparison-workload-v5.schema.json" },
    "schema_version": { "const": "bp-comparison-workload-v3" },
    "manifest_id": { "const": "bp-perf-v5-decision-1" },
    "decision_contract_version": { "const": "bp-perf-v5-decision-1" },
    "supersedes": { "const": "bp-perf-v4-decision-1" },
    "seed": { "type": "integer" },
    "source_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file", "artifact_sha256", "byte_sha256"],
      "properties": {
        "id": { "const": "bp-perf-v4-decision-1" },
        "file": { "const": "./comparison-workload-v4.materialized.json" },
        "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "byte_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "journey_extensions": { "type": "array", "minItems": 2, "maxItems": 2 },
    "additional_journeys": { "type": "array", "minItems": 1, "maxItems": 1 },
    "additional_commands": { "type": "array", "minItems": 7, "maxItems": 7 },
    "expected_extensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hard_component_failure_policy",
        "gpui_multi_document_absolute_safety_budgets",
        "dynamic_fidelity",
        "native_property_edit_undo",
        "native_snap_transform_120hz",
        "multi_document_session"
      ],
      "properties": {
        "hard_component_failure_policy": { "type": "string", "minLength": 1 },
        "gpui_multi_document_absolute_safety_budgets": {
          "$ref": "#/$defs/gpuiMultiDocumentAbsoluteSafetyBudgets"
        },
        "dynamic_fidelity": {
          "type": "object",
          "required": [
            "registered_crop_count",
            "comparison_algorithm",
            "minimum_filtered_ssim_each",
            "minimum_dark_precision_each",
            "minimum_dark_recall_each",
            "minimum_dark_f1_each",
            "zoom_percent",
            "device_pixels_per_pdf_point",
            "pixels_per_point_tolerance",
            "paired_candidate_scale_tolerance",
            "checkpoint_hold_count",
            "checkpoint_hold_ms_each",
            "candidate_resampling",
            "reference_resampling",
            "presented_screenshot_stability",
            "observer_sample_count",
            "visible_page_ready_fraction",
            "visible_raster_ready_area_fraction",
            "visible_raster_pixel_density",
            "missing_or_nonfinite_sample",
            "higher_is_better_lower_95_ratio_threshold"
          ],
          "properties": {
            "registered_crop_count": { "const": 3 },
            "comparison_algorithm": {
              "const": "bp-cross-engine-binary-scan-fidelity-v2"
            },
            "minimum_filtered_ssim_each": { "const": 0.97 },
            "minimum_dark_precision_each": { "const": 0.99 },
            "minimum_dark_recall_each": { "const": 0.99 },
            "minimum_dark_f1_each": { "const": 0.99 },
            "zoom_percent": { "const": 100 },
            "device_pixels_per_pdf_point": { "const": 1 },
            "pixels_per_point_tolerance": { "const": 0.01 },
            "paired_candidate_scale_tolerance": { "const": 0.01 },
            "checkpoint_hold_count": { "const": 3 },
            "checkpoint_hold_ms_each": { "const": 250 },
            "candidate_resampling": { "const": "forbidden" },
            "reference_resampling": {
              "const": "downsample-only-lanczos3"
            },
            "presented_screenshot_stability": {
              "const": "painted-before-capture-after"
            },
            "observer_sample_count": { "const": 1921 },
            "missing_or_nonfinite_sample": { "const": "hard-failure" }
          }
        },
        "native_property_edit_undo": { "type": "object" },
        "native_snap_transform_120hz": { "type": "object" },
        "multi_document_session": { "type": "object" }
      }
    },
    "canonical_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representative_command_stream_sha256",
        "representative_milestone_stream_sha256",
        "representative_fixture_command_mapping_sha256",
        "stress_command_stream_sha256",
        "expected_state_sha256"
      ],
      "properties": {
        "representative_command_stream_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "representative_milestone_stream_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "representative_fixture_command_mapping_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "stress_command_stream_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expected_state_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "$defs": {
    "gpuiMultiDocumentAbsoluteSafetyBudgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicability",
        "aggregation",
        "conjunction",
        "outcomes",
        "metrics"
      ],
      "properties": {
        "applicability": {
          "const": "every-live-gpui-multi-document-session-report; mandatory-when-electron-benefit-metrics-ineligible"
        },
        "aggregation": {
          "const": "maximum-across-retained-final-gpui-multi-document-reports"
        },
        "conjunction": { "const": "all-seven" },
        "outcomes": {
          "const": {
            "exceeded_finite_valid": "measured-no",
            "missing_nonfinite_or_structurally_invalid": "blocked-not-decision-ready"
          }
        },
        "metrics": {
          "const": {
            "cpu_seconds": {
              "maximum": 120,
              "unit": "process-cpu-seconds",
              "provenance": "new-v5-safety-cap-no-v4-absolute"
            },
            "cgroup_peak_memory_bytes": {
              "maximum": 1610612736,
              "unit": "bytes",
              "provenance": "summarize-paired-v4 process_memory absoluteBudgetFor"
            },
            "product_wall_or_latency_ms": {
              "maximum": 60000,
              "unit": "milliseconds",
              "allowed_source": ["product-latency", "component-wall"],
              "provenance": "new-v5-safety-cap-no-v4-multi-document-map"
            },
            "application_frame_interval_p95_ms": {
              "maximum": 25,
              "unit": "milliseconds",
              "provenance": "v4 native frame absoluteBudgetFor"
            },
            "native_input_to_application_frame_ack_p95_ms": {
              "maximum": 33.333333333333336,
              "unit": "milliseconds",
              "provenance": "v4 1000/30 native ack absoluteBudgetFor"
            },
            "baseline_adjusted_gpu_peak_memory_mib": {
              "maximum": 2048,
              "unit": "MiB",
              "provenance": "v4 GPU memory absoluteBudgetFor"
            },
            "baseline_adjusted_gpu_utilization_p95_percent": {
              "maximum": 100,
              "unit": "percent",
              "provenance": "new-v5 physical percentage ceiling"
            }
          }
        }
      }
    }
  }
}

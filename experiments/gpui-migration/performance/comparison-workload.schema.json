{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://butterpaper.app/schemas/bp-comparison-workload-v1.json",
  "title": "Butter Paper comparison workload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "decision_contract_version", "seed", "coordinate_space", "environment", "fixtures", "assets", "journeys", "expected", "canonical_hashes"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "bp-comparison-workload-v1" },
    "manifest_id": { "const": "bp-perf-v3-decision-3" },
    "decision_contract_version": { "const": "bp-perf-v3-decision-3" },
    "seed": { "type": "integer" },
    "coordinate_space": { "const": "pdf-points-bottom-left" },
    "environment": { "type": "object" },
    "fixtures": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role"],
        "properties": { "id": { "type": "string" }, "role": { "type": "string" } }
      }
    },
    "assets": { "type": "array" },
    "journeys": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fixtures", "commands"],
        "properties": {
          "id": { "type": "string" },
          "fixtures": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "commands": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "operation", "expected_milestones"],
              "properties": {
                "id": { "type": "string" },
                "operation": { "type": "string" },
                "expected_milestones": { "type": "array", "minItems": 1, "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "expected": { "type": "object", "required": ["milestone_rules", "final_state"] },
    "canonical_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_stream_sha256", "milestone_stream_sha256", "expected_state_sha256"],
      "properties": {
        "command_stream_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "milestone_stream_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "expected_state_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}

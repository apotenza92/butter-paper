{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "butter-paper-signature-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "durable_objects": {
    "bindings": [
      {
        "name": "SIGNATURE_SESSIONS",
        "class_name": "SignatureSession"
      }
    ]
  },
  "exports": {
    "SignatureSession": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "RELAY_ENABLED": "false"
  },
  "ratelimits": [
    {
      "name": "CREATE_RATE_LIMITER",
      "namespace_id": "41021",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "UPLOAD_RATE_LIMITER",
      "namespace_id": "41022",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "RETRIEVAL_RATE_LIMITER",
      "namespace_id": "41023",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}

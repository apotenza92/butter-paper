<?xml version="1.0" encoding="utf-8"?>
<!-- The Microsoft Store package's manifest. cargo xtask package fills in the
     placeholder values from xtask/templates/windows/store-identity.json (the app's
     identity in Partner Center), the version and the architecture. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">
  <Identity Name="@NAME@" Publisher="@PUBLISHER@" Version="@VERSION@.0" ProcessorArchitecture="@ARCH@" />
  <Properties>
    <DisplayName>Butter Paper</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
    <!-- The Visual C++ runtime, which the Store installs with the app. -->
    <PackageDependency Name="Microsoft.VCLibs.140.00.UWPDesktop" MinVersion="14.0.33519.0" Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="ButterPaper" Executable="butter-paper.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Butter Paper"
        Description="Review and mark up PDFs."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Lists Butter Paper in Open With and Default Apps for PDFs. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="pdf">
            <uap:DisplayName>PDF Document</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType ContentType="application/pdf">.pdf</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <!-- A full desktop app: it opens and saves PDFs anywhere the user chooses. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>

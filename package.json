{
  "name": "butter-paper",
  "version": "0.0.30",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "24.16.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "@hono/node-server": "2.0.10",
      "@xmldom/xmldom": "0.8.13",
      "brace-expansion@1": "1.1.16",
      "brace-expansion@2": "2.1.2",
      "brace-expansion@5": "5.0.9",
      "fast-uri": "3.1.4",
      "postcss": "8.5.18",
      "tar": "7.5.22",
      "tmp": "0.2.7"
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "check:repo": "node scripts/check-repository-hygiene.mjs",
    "check:icons": "node scripts/generate-icons.mjs --check",
    "test": "vitest run --config vitest.config.mts && pnpm --filter @butter-paper/signature-relay test",
    "check": "pnpm check:repo && pnpm check:ui && pnpm check:icons && pnpm typecheck && pnpm build && pnpm test",
    "postinstall": "node scripts/ensure-native-deps.mjs",
    "dev:cli": "pnpm --filter @butter-paper/cli dev",
    "generate:fixtures": "node scripts/generate-fixtures.mjs",
    "generate:icons": "node scripts/render-brand-icons.mjs && node scripts/generate-icons.mjs",
    "lint:ui": "pnpm check:ui",
    "check:ui": "node --test experiments/gpui-migration/gpui-migration/tests/document-tab-style-source.test.mjs experiments/gpui-migration/gpui-migration/tests/application-menu-source.test.mjs experiments/gpui-migration/gpui-migration/tests/ui-policy-source.test.mjs"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.2",
    "vitest": "4.1.4",
    "yaml": "2.9.0"
  }
}

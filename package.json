{
  "name": "butter-paper",
  "version": "0.0.18",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "24.16.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "@hono/node-server": "2.0.10",
      "@xmldom/xmldom": "0.8.13",
      "brace-expansion@1": "1.1.16",
      "brace-expansion@2": "2.1.2",
      "brace-expansion@5": "5.0.9",
      "fast-uri": "3.1.4",
      "postcss": "8.5.18",
      "tar": "7.5.22",
      "tmp": "0.2.7"
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "check:repo": "node scripts/check-repository-hygiene.mjs",
    "audit:shadcn": "node scripts/audit-shadcn-registry.mjs",
    "check:icons": "node scripts/generate-icons.mjs --check",
    "test": "vitest run --config vitest.config.mts",
    "test:e2e": "playwright test",
    "test:e2e:startup": "node tests/e2e/startup-probe.mjs",
    "test:package:desktop": "node scripts/smoke-packaged-desktop.mjs",
    "test:macos-verifier": "vitest run --config vitest.config.mts tests/macos-package-verifier.test.ts",
    "test:macos-updater": "node scripts/test-macos-update.mjs",
    "check": "pnpm check:repo && pnpm check:icons && pnpm typecheck && pnpm build && pnpm test",
    "postinstall": "node scripts/ensure-native-deps.mjs",
    "predev:desktop": "node scripts/prepare-desktop-dev.mjs && pnpm --filter @butter-paper/core build && pnpm --filter @butter-paper/pdf build",
    "dev:desktop": "pnpm --filter @butter-paper/desktop dev",
    "benchmark:desktop:performance": "node scripts/prepare-desktop-dev.mjs && pnpm build:desktop && node scripts/benchmark-desktop-performance.mjs",
    "dev:cli": "pnpm --filter @butter-paper/cli dev",
    "build:desktop": "pnpm --filter @butter-paper/desktop... build",
    "package:desktop": "pnpm build:desktop && pnpm --dir apps/desktop package",
    "make:desktop": "pnpm build:desktop && pnpm --dir apps/desktop make",
    "make:desktop:mac": "pnpm build:desktop && pnpm --dir apps/desktop make:mac",
    "build:release:mac": "node scripts/build-signed-macos.mjs",
    "verify:release:mac": "node scripts/verify-macos-package.mjs",
    "assemble:update-metadata": "node scripts/assemble-update-metadata.mjs",
    "make:desktop:windows": "pnpm build:desktop && pnpm --dir apps/desktop make:windows",
    "make:desktop:linux": "pnpm build:desktop && pnpm --dir apps/desktop make:linux",
    "generate:fixtures": "node scripts/generate-fixtures.mjs",
    "generate:icons": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "@electron/asar": "4.2.1",
    "@playwright/test": "1.59.1",
    "@tufjs/canonical-json": "2.0.0",
    "@types/node": "25.6.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.2",
    "vitest": "4.1.4",
    "yaml": "2.9.0"
  }
}
